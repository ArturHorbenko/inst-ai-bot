# Backend database
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=creator-kb

# AI providers
OPENAI_API_KEY=
TWELVE_LABS_API_KEY=
TWELVE_LABS_INDEX_NAME=default-index
TWELVE_LABS_INDEX_ID=
ANALYTICS_DASHBOARD_URL=
ANALYTICS_DASHBOARD_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# MCP authentication. Public deployments must not use disabled-dev.
MCP_AUTH_MODE=bearer
INST_AI_BOT_API_KEY=

# Hosted ChatGPT/Claude OAuth resource-server mode.
# Set MCP_AUTH_MODE=oauth, or oauth-and-bearer during migration.
MCP_RESOURCE_URL=https://mcp.example.com/mcp
MCP_OAUTH_ISSUER_URL=https://auth.example.com/
MCP_OAUTH_JWKS_URL=https://auth.example.com/jwks.json
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_OAUTH_SCOPE=instagram-creator:use
MCP_OAUTH_ALGORITHMS=RS256

# Self-hosted single-user OAuth authorization server (scripts/run_oauth.py).
# Generate the key and password hash with scripts/setup_oauth_secrets.py.
OAUTH_ADMIN_PASSWORD_HASH=
OAUTH_SIGNING_KEY_PATH=secrets/oauth-signing-key.pem
OAUTH_SIGNING_KEY_ID=inst-ai-bot-oauth-1
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_HOST=127.0.0.1
OAUTH_PORT=8003

# Atlas Vector Search for timestamped Reel retrieval.
# Use an Atlas MongoDB URI; the index is created with scripts/setup_atlas_vector_index.py.
ATLAS_VECTOR_INDEX=video_retrieval_vector
RETRIEVAL_EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_EMBEDDING_DIMENSIONS=768
ATLAS_VECTOR_INDEX_TIMEOUT=300
ATLAS_VECTOR_INDEX_POLL_INTERVAL=5

# TwelveLabs processing behavior
ENABLE_MULTIMODAL_ANALYSIS=true
INDEXING_TIMEOUT=1800
INDEXING_POLL_INTERVAL=10
SUPPORTED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm,m4v

# Legacy/local pipeline defaults
VIDEO_PATH=./reels/3505607525892794154_5599290503.mp4
VIDEO_ID=3505607525892794154_5599290503.mp4
IMAGE_DIR=./scenes

# Auth script (auth/index.py)
FB_TOKEN=
